<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail_attach_to_record.MailBufferMenu">
        <div t-att-class="discussSystray.class">
            <Dropdown
                menuClass="discussSystray.menuClass"
                position="'bottom-end'"
                bottomSheet="false"
                beforeOpen.bind="beforeOpen"
            >
                <button class="bg-transparent border-0" aria-label="Mail Buffer">
                    <i class="fa fa-lg fa-envelope" role="img" />
                    <span
                        t-if="mailBufferCounter"
                        class="o-mail-MessagingMenu-counter badge rounded-pill"
                    >
                        <t t-esc="mailBufferCounter" />
                    </span>
                </button>
                <t t-set-slot="content">
                    <t t-call="mail.MailBufferMenu.content" />
                </t>
            </Dropdown>
        </div>
    </t>

    <t t-name="mail.MailBufferMenu.content">
        <div t-att-class="`${discussSystray.contentClass} o-mail-MessagingMenu`">
            <div
                class="o-mail-MessagingMenu-list d-flex flex-column overflow-auto o-scrollbar-thin flex-grow-1 list-group list-group-flush o-scrollbar-thin"
            >
                <t t-if="state.isLoading">
                    <div
                        class="d-flex align-items-center justify-content-center gap-2 py-4 px-2"
                    >
                        <i class="fa fa-circle-o-notch fa-spin me-1" /> Loading…
                    </div>
                </t>
                <t t-elif="!state.messages.length">
                    <div class="d-flex justify-content-center py-4 px-2 text-muted">
                        No buffered emails.
                    </div>
                </t>
                <t t-else="">
                    <t t-foreach="state.messages" t-as="message" t-key="message.id">
                        <NotificationItem
                            nameMaxLine="1"
                            textMaxLine="2"
                            datetime="message.date"
                            onClick="() => this.attachMessage(message)"
                        >
                            <t t-set-slot="name">
                                <t t-esc="message.email_from" />
                            </t>
                            <t t-set-slot="body">
                                <span t-out="message.subject" />
                            </t>
                        </NotificationItem>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
